# Copia este archivo a ".env" y completa tus datos reales.
# Opción A: una sola URL de conexión (así la dan Railway, Neon, Supabase, etc.)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/pulsefit

# Opción B: variables sueltas (si no usas DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pulsefit

# Cualquier texto largo y secreto — cámbialo por el tuyo
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto

PORT=4000
